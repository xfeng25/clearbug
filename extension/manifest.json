{
  "manifest_version": 3,
  "name": "ClearBug – UAT Test Runner & Bug Reporter",
  "short_name": "ClearBug",
  "version": "0.4.2",
  "description": "Import your UAT test cases, run them step by step, and turn failures into developer-ready bug reports with evidence.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open ClearBug",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "commands": {
    "report-bug": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Capture the screen and report a bug"
    }
  },
  "options_page": "options.html",
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
